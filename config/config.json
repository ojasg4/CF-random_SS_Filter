{
  "thresholds": {
    "min_consecutive_changed_residues": 4,
    "min_region_separation_to_keep_separate": 6,
    "max_total_change_regions": 2,
    "rmsd_threshold": 1.0
  },

  "dssp_codes": {
    "helix":      ["H", "G", "I"],
    "beta":       ["E", "B"],
    "kappa":      ["P"],
    "disordered": ["T", "S", "-", "", " ", "C"]
  },

  "groups": {
    "helix":      "HELIX",
    "beta":       "BETA",
    "kappa":      "KAPPA",
    "disordered": "DISORDERED"
  },

  "group_single_letter": {
    "HELIX":      "H",
    "BETA":       "B",
    "KAPPA":      "P",
    "DISORDERED": "C"
  },

  "summary_files": {
    "likely":   "likely_predictions.csv",
    "unlikely": "unlikely_predictions.csv"
  },
  "unassigned_filter": {
      "max_alternative_percent": 35.0
    },

  "csv_columns": {
    "base_prefix": [
      "input_pse",
      "alt_model",
      "classification",
      "rmsd_to_dominant",
      "n_switch_residues",
      "n_switch_regions",
      "n_disordered_change_residues",
      "n_disordered_change_regions",
      "invalid_reason"
    ],
    "base_suffix": [
      "run_mode",
      "sequences_identical",
      "selected_colored_pse",
      "raw_dssp_dir",
      "saved_folds_dir"
    ],
    "keep_going": [
      "keep_going_n_likely_hit_structures",
      "keep_going_likely_hit_pdb_files"
    ],
    "phenix_mode_columns": [
      "dom_phenix_Predictive",
      "dom_phenix_Unpacked high pLDDT",
      "dom_phenix_Unpacked possible",
      "dom_phenix_Near-predictive",
      "dom_phenix_Pseudostructure",
      "dom_phenix_Barbed wire",
      "dom_phenix_Unphysical",
      "dom_phenix_Unassigned",
      "alt_phenix_Predictive",
      "alt_phenix_Unpacked high pLDDT",
      "alt_phenix_Unpacked possible",
      "alt_phenix_Near-predictive",
      "alt_phenix_Pseudostructure",
      "alt_phenix_Barbed wire",
      "alt_phenix_Unphysical",
      "alt_phenix_Unassigned"
    ],
    "recovery_metrics": [
      "same_ss_preserved",
      "same_ss_recovery_region_count",
      "same_ss_recovery_regions",
      "same_ss_recovery_max_avg_distance"
    ],
    "unassigned_metrics": [
      "dom_poor_structure_percent",
      "dom_poor_structure_n_regions",
      "dom_poor_structure_avg_region_length",
      "alt_poor_structure_percent",
      "alt_poor_structure_n_regions",
      "alt_poor_structure_avg_region_length"
    ],
    "chainsaw_columns": ["dom_chainsaw", "alt_chainsaw"]
  }
}
